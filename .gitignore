# Uploaded images and heatmaps (keep the folders, ignore the contents)
backend/app/storage/uploads/*
backend/app/storage/heatmaps/*
!backend/app/storage/uploads/.gitkeep
!backend/app/storage/heatmaps/.gitkeep

# Model files. The five fold models are small (~0.3 MB each) and the app needs them,
# so the ones in backend/app/ml_models are kept. Any other .keras file stays ignored.
*.keras
!backend/app/ml_models/*.keras

